[Unit]
Description=Weaviate Vector Database
After=network.target

[Service]
ExecStart=/opt/weaviate/weaviate
WorkingDirectory=/var/lib/weaviate
User=weaviate
Restart=always

Environment=QUERY_DEFAULTS_LIMIT=100
Environment=AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=true
Environment=PERSISTENCE_DATA_PATH=/var/lib/weaviate
Environment=ENABLE_MODULES=text2vec-transformers

# ★ ポート変更（デフォルト 8080 → 任意）
Environment=PORT={{ weaviate_port }}

[Install]
WantedBy=multi-user.target
