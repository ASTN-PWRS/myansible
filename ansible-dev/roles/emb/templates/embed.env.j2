# Embed CLI environment file
# このファイルは emb.sh から source される

# ローカルモデルパス（/opt/models/bge-m3/current）
EMBED_MODEL="{{ embed_model | default('/opt/models/bge-m3/current') }}"

# ログレベル（必要なら）
EMBED_LOG_LEVEL="{{ embed_log_level | default('INFO') }}"

# CPU スレッド数（必要なら）
EMBED_NUM_THREADS="{{ embed_num_threads | default(4) }}"
