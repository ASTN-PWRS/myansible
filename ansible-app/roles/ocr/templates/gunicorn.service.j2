[Unit]
Description={{ app_name }} FastAPI Service (Gunicorn + UvicornWorker)
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/opt/{{ app_name }}

ExecStart=/opt/{{ app_name }}/venv/bin/gunicorn main:app \
  -k uvicorn.workers.UvicornWorker \
  --workers 2 \
  --max-requests 1000 \
  --max-requests-jitter 200 \
  --bind 0.0.0.0:{{ port }}

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
